generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               String               @default("CUSTOMER") // CUSTOMER | ADMIN
  emailVerified      DateTime?
  points             Int                  @default(0) // loyalty points balance
  taxExempt          Boolean              @default(false)
  exemptionCertUrl   String?
  referralCode       String?              @unique
  referralsMade      Referral[]           @relation("referrer")
  referralReceived   Referral?            @relation("referee")
  reviews            Review[]
  addresses          Address[]
  orders             Order[]
  resetTokens        PasswordResetToken[]
  verificationTokens VerificationToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Lab")
  recipient String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String   @default("United States")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String  @default("")
  description String

  category String

  // Research-peptide specifications
  purity           String @default("") // e.g. "≥99%"
  form             String @default("Lyophilized powder")
  casNumber        String @default("")
  molecularFormula String @default("")
  molecularWeight  String @default("")
  sequence         String @default("")
  storage          String @default("")
  coaUrl           String @default("") // Certificate of Analysis link

  featured  Boolean          @default(false)
  active    Boolean          @default(true)
  imageKey  String           @default("default")
  variants  ProductVariant[]
  reviews   Review[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label             String // e.g. "5mg", "10mg vial"
  sku               String      @unique
  price             Float
  salePrice         Float?
  saleEndsAt        DateTime?
  stock             Int         @default(0)
  lowStockThreshold Int         @default(10)
  active            Boolean     @default(true)
  sortOrder         Int         @default(0)
  orderItems        OrderItem[]
  stockNotifications StockNotification[]
  createdAt         DateTime    @default(now())
}

model StockNotification {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email     String
  notified  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@unique([variantId, email])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int?
  amountOff  Float?
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  status          String      @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  paymentProvider String?     // "stripe" | "paypal" | "simulated"
  paymentRef      String?
  ruoAcknowledged Boolean     @default(false)
  subtotal        Float
  discount        Float       @default(0)
  shipping        Float       @default(0)
  tax             Float       @default(0)
  total           Float
  couponCode      String?
  pointsRedeemed  Int         @default(0) // loyalty points spent on this order
  shippingAddress String // JSON
  billingAddress  String // JSON
  trackingNumber  String?
  trackingCarrier String?
  labelUrl        String?
  shippedAt       DateTime?
  refundedAt      DateTime?
  items           OrderItem[]
  returns         ReturnRequest[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | COMPLETED
  createdAt DateTime @default(now())
}

model TaxRate {
  id        String   @id @default(cuid())
  state     String   @unique // 2-letter state code
  percent   Float // e.g. 8.25
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  detail     String   @default("")
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String   @default("")
  body       String   @default("")
  status     String   @default("PENDING") // PENDING | APPROVED | HIDDEN
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AbandonedCart {
  id         String    @id @default(cuid())
  email      String    @unique
  items      String // JSON snapshot of cart
  total      Float
  remindedAt DateTime?
  recovered  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Post {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String   @default("")
  body         String   @default("") // markdown
  coverImageKey String  @default("")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(false)
  maintenanceCode String   @default("")
  updatedAt       DateTime @updatedAt
}

model Referral {
  id                 String   @id @default(cuid())
  referrerId         String
  referrer           User     @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId          String?  @unique
  referee            User?    @relation("referee", fields: [refereeId], references: [id], onDelete: SetNull)
  refereeEmail       String?
  status             String   @default("PENDING") // PENDING | COMPLETED
  refereeCouponCode  String?
  referrerCouponCode String?
  createdAt          DateTime @default(now())
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug  String
  name         String
  variantLabel String          @default("")
  sku          String          @default("")
  imageKey     String          @default("default")
  unitPrice    Float
  quantity     Int
}
