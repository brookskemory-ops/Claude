# SQLite for local/demo use. Swap for a Postgres URL in production, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/axevia"
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT). Use a long random string in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"
