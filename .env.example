# ---- Database ----
# Local dev uses Postgres. For production, point this at a hosted Postgres (Neon, RDS, etc.).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/axevia?schema=public"

# ---- Auth ----
# Secret used to sign session cookies (JWT). Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"

# ---- Payments (provider-agnostic) ----
# Leave blank to use the built-in simulated checkout (dev/demo). Fill in to enable real flows.
# NOTE: Stripe/PayPal prohibit peptides/research chemicals for production; use a high-risk
# processor when you go live. These keys are for development/testing the flow only.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_ENV="sandbox"

# Authorize.Net (high-risk / peptide-friendly card processing). Leave blank until your
# merchant account is approved; fill in to enable hosted card checkout.
AUTHNET_API_LOGIN_ID=""
AUTHNET_TRANSACTION_KEY=""
AUTHNET_SIGNATURE_KEY=""
AUTHNET_ENV="sandbox"   # "sandbox" or "production"

# ---- Email (Resend) ----
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Axevia <noreply@axevia.com>"

# ---- Shipping (EasyPost) ----
# Leave blank to enter tracking numbers manually instead of buying labels.
EASYPOST_API_KEY=""
SHIP_FROM_NAME="Axevia"
SHIP_FROM_STREET=""
SHIP_FROM_CITY=""
SHIP_FROM_STATE=""
SHIP_FROM_ZIP=""
SHIP_FROM_COUNTRY="US"
SHIP_FROM_PHONE=""

# ---- COA file storage ----
# On Vercel, enable Blob storage and this is set automatically. Locally, leave blank
# to store uploaded COA files on disk (public/uploads).
BLOB_READ_WRITE_TOKEN=""

# Where low-stock alert emails go (defaults to the first admin user's email).
ADMIN_EMAIL=""

# ---- Maintenance / coming-soon gate ----
# Set MAINTENANCE_MODE="on" to show a coming-soon page to the public. Admins and anyone with
# the bypass code (entered on the maintenance page) can still browse the real site.
MAINTENANCE_MODE=""
MAINTENANCE_BYPASS_CODE=""

# ---- Analytics ----
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=""

# ---- Cron ----
# Shared secret for the abandoned-cart cron endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# ---- App ----
# Production: set to your domain, e.g. https://axevia.co
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
