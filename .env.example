# ---- Database ----
# Local dev uses Postgres. For production, point this at a hosted Postgres (Neon, RDS, etc.).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/axevia?schema=public"

# ---- Auth ----
# Secret used to sign session cookies (JWT). Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"

# ---- Payments (provider-agnostic) ----
# Leave blank to use the built-in simulated checkout (dev/demo). Fill in to enable real flows.
# NOTE: Stripe/PayPal prohibit peptides/research chemicals for production; use a high-risk
# processor when you go live. These keys are for development/testing the flow only.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_ENV="sandbox"

# ---- Email (Resend) ----
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Axevia <noreply@axevia.com>"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
